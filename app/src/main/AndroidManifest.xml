<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para usar NFC -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />


    <application
        android:name=".RegistrosApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RegistrosAllCashless.NoActionBar.Light"
        tools:targetApi="31">
        <!-- Pantalla de carga, modo claro y orientación en portrait -->
        <activity
            android:name=".view.PantallaDeCarga"
            android:exported="true"
            android:forceDarkAllowed="false"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login, modo claro y orientación en portrait -->
        <activity
            android:name=".view.LoginActivity"
            android:exported="false"
            android:forceDarkAllowed="false"
            android:screenOrientation="portrait" />

        <!-- Eventos, modo claro y orientación en portrait -->
        <activity
            android:name=".view.EventosActivity"
            android:exported="true"
            android:forceDarkAllowed="false"
            android:screenOrientation="portrait" />

        <!-- Lectura manilla, modo claro y orientación en portrait -->
        <activity
            android:name=".view.LecturaManillaActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:forceDarkAllowed="false">
            <!-- Agregar este intent-filter para que la app se abra al escanear NFC -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
            </intent-filter>

            <meta-data
                android:name="android.nfc.action.TAG_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

        </activity>

    </application>

</manifest>