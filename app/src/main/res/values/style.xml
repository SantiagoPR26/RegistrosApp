<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para todos los TextViews dentro del card -->
    <style name="CardTextStyle">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/orange</item>
    </style>

    <style name="CardTextStyleCarrito2">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/orange</item>
    </style>

    <style name="NewAmountStyle">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/orange</item>
    </style>

    <style name="CardTextStyleDatos2">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CardTextStyleDatos">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CardTextStyleEventos">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/orange</item>
    </style>

    <style name="CardTextStyleEventosInfo">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextStyleLoginInfo">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="TextStyleLoginInfo2">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/blue</item>
    </style>


    <style name="CardTextStyleCarritoDatos">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="CardTextStyleCarrito">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Estilo para todos los Laabels en Views dentro -->
    <style name="LabelsTextStyle">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/orange</item>
    </style>

    <style name="LabelsTextStyleDark">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CardValuesStyle">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Estilo para el botón -->
    <style name="RecargarButtonStyle">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/white</item>

        <item name="android:layout_marginBottom">5dp</item>
        <!-- Margen general para todos los lados -->
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>

    <!-- Estilo para el botón -->
    <style name="LoginButtonStyle">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/white</item>

        <item name="android:layout_marginBottom">5dp</item>
        <!-- Margen general para todos los lados -->
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>

    <!-- Estilo para el botón -->
    <style name="CancelarButtonStyle">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/blue</item>

        <!-- Margen general para todos los lados -->
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>

    <!-- Estilo para quitar actionBar en las Activity-->
    <style name="Theme.RecargasAllCashless.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Estilo para el TextInputEdit  -->
    <style name="TextInputEditStyle" >
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColorHighlight">@color/dark_grey</item>
    </style>


    <!-- Estilo de margenes para diferentes elementos-->
    <style name="CustomMarginStyle">
        <item name="android:layout_marginBottom">5dp</item><!-- Margen general para todos los lados -->
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>

    <!-- Estilo para buttons -->
    <style name="CustomRadioButtonStyle">
        <item name="fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:buttonTint">@color/blue</item>

    </style>

</resources>